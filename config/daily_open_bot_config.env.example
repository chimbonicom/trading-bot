# Daily Open Line Fakeout Bot Configuration
# =============================================
# Copy to daily_open_bot_config.env and fill in your credentials

# MT5 Account - Replace with your credentials
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# Trading Configuration
SYMBOLS=GBPJPY.s
TIMEFRAME=M5
LOT_SIZES=0.5

# Risk Management
MAX_OPEN_TRADES=2
MAX_DAILY_TRADES=5
RISK_REWARD_RATIO=3.0
SWEEP_TOLERANCE_PIPS=3
BIAS_CONFIRMATION_PIPS=5

# Daily Open Override (0 = automatic detection)
DAILY_OPEN_OVERRIDE=0

# Bot Performance Settings
MAIN_LOOP_SLEEP=5
STATUS_LOG_INTERVAL=300

# Bot Behavior
AUTO_REPORTS=true
REPORT_INTERVAL=3600
LOG_LEVEL=INFO

# Advanced Settings
MAGIC_NUMBER=234002
ORDER_DEVIATION=20
MIN_TRADE_INTERVAL=60
ENABLE_SMART_LOGGING=true
ENABLE_PERFORMANCE_TRACKING=true
