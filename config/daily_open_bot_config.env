# Daily Open Line Fakeout Bot Configuration
# =============================================

# MT5 Demo Account Configuration
MT5_LOGIN=2001258379
MT5_PASSWORD=MA1@ANgaaa
MT5_SERVER=JustMarkets-Demo

# Trading Configuration
# ====================
# Symbols to trade (comma-separated)
SYMBOLS=GBPJPY.s

# Timeframe for analysis
TIMEFRAME=M5

# Lot sizes for each symbol (comma-separated, must match SYMBOLS order)
LOT_SIZES=0.5

# Risk Management
# ===============
# Maximum number of open trades at once
MAX_OPEN_TRADES=2

# Maximum number of trades per day (0 = unlimited)
MAX_DAILY_TRADES=5

# Risk:Reward ratio (1:3 means TP is 3x the SL distance)
RISK_REWARD_RATIO=3.0

# Sweep tolerance in pips (minimum distance for sweep detection)
SWEEP_TOLERANCE_PIPS=3

# Bias confirmation in pips (how far price must be from daily open to confirm bias)
BIAS_CONFIRMATION_PIPS=5

# Daily Open Override (set to 0 to use automatic detection, or set specific value for testing)
# Example: DAILY_OPEN_OVERRIDE=198.487
DAILY_OPEN_OVERRIDE=198.487

# Bot Performance Settings
# =======================
# Main loop sleep time in seconds (5 = check every 5 seconds, 1 = check every second)
MAIN_LOOP_SLEEP=5

# Status log interval in seconds (300 = every 5 minutes, 60 = every minute)
STATUS_LOG_INTERVAL=300

# Bot Behavior
# ============
# Enable automatic performance reports
AUTO_REPORTS=true

# Report generation interval in seconds (3600 = 1 hour)
REPORT_INTERVAL=3600

# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Advanced Settings
# ================
# Magic number for trade identification
MAGIC_NUMBER=234002

# Order deviation in points
ORDER_DEVIATION=20

# Minimum time between trades in seconds
MIN_TRADE_INTERVAL=60

# Enable/disable specific features
ENABLE_SMART_LOGGING=true
ENABLE_PERFORMANCE_TRACKING=true
